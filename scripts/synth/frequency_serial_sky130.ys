# Preparación del núcleo ASIC. scripts/ppa.py aplica SKY130 HD y guarda netlist/área.
read_verilog -sv rtl/frequency/complex_mul_serial_control.sv rtl/frequency/complex_mul_serial.sv rtl/frequency/frequency_block_roms.sv rtl/frequency/frequency_block_engine_control.sv rtl/frequency/frequency_block_engine.sv rtl/frequency/fir_frequency_serial_control.sv rtl/frequency/fir_frequency_serial.sv
synth -noabc -flatten -top fir_frequency_serial
check -assert
