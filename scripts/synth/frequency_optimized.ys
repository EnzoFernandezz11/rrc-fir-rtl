# C04 structural synthesis; physical timing requires Vivado.
read_verilog -sv rtl/frequency_optimized/frequency_csd_mul.sv rtl/frequency_optimized/frequency_complex_const.sv rtl/frequency_optimized/frequency_butterfly.sv rtl/frequency_optimized/frequency_fft16.sv rtl/frequency_optimized/frequency_spectral16.sv rtl/frequency_optimized/frequency_output_scale.sv rtl/frequency_optimized/fir_frequency_optimized_control.sv rtl/frequency_optimized/fir_frequency_optimized.sv
hierarchy -check -top fir_frequency_optimized
proc
flatten
opt
check -assert
select -assert-none t:$mul t:$dlatch
synth -top fir_frequency_optimized
check -assert
stat
